{
  "_comment": "Pass/fail gates for evals/run_suite.py. 'candidate' is the Crisp version under test, 'baseline' is Claude with no plugin. Pairwise numbers come from a blind judge that sees each pair in both orders.",
  "gates": [
    {"id": "G1", "suite": "content", "name": "No net loss of critical information",
     "metric": "critical_cut_minus_added_per_pair", "op": "<=", "value": 0.0,
     "why": "Critical items are the ones whose absence can cause a mistake or data loss."},
    {"id": "G2", "suite": "content", "name": "Few critical items cut at all",
     "metric": "critical_cut_per_pair", "op": "<=", "value": 0.1},
    {"id": "G3", "suite": "content", "name": "Useful information is not net-cut",
     "metric": "useful_cut_to_added_ratio", "op": "<=", "value": 1.25,
     "why": "Some trade is normal. A ratio above 1.25 means Crisp removes useful content."},
    {"id": "G4", "suite": "content", "name": "Not less useful than no plugin (preference)",
     "metric": "preference_margin", "op": ">=", "value": 0.0,
     "why": "Candidate wins plus half of ties, minus baseline wins, as a share of pairs."},
    {"id": "G5", "suite": "content", "name": "Must-cover fact coverage",
     "metric": "coverage_delta_pts", "op": ">=", "value": -2.0},
    {"id": "G6", "suite": "content", "name": "Accuracy holds",
     "metric": "accuracy_delta", "op": ">=", "value": -0.3},
    {"id": "G7", "suite": "content", "name": "Readability score",
     "metric": "candidate_checker_score", "op": ">=", "value": 85},
    {"id": "G8", "suite": "content", "name": "Sentences over the limit",
     "metric": "candidate_over_limit_per_answer", "op": "<=", "value": 0.5},
    {"id": "G9", "suite": "content", "name": "Not longer than no plugin",
     "metric": "length_ratio", "op": "<=", "value": 1.10,
     "why": "Crisp keeps content but removes filler, so it must not grow the answer."},
    {"id": "G10", "suite": "content", "name": "Requests for depth get full answers",
     "metric": "depth_length_ratio", "op": ">=", "value": 0.85},
    {"id": "G11", "suite": "content", "name": "Code in answers still compiles",
     "metric": "code_compile_rate", "op": ">=", "value": 1.0},
    {"id": "G12", "suite": "all", "name": "Never mentions Crisp or its rules",
     "metric": "meta_leaks", "op": "<=", "value": 0},
    {"id": "G13", "suite": "strict", "name": "Strict level keeps content",
     "metric": "strict_coverage_delta_pts", "op": ">=", "value": -5.0},
    {"id": "G14", "suite": "strict", "name": "Strict level is at least as readable as lite",
     "metric": "strict_minus_lite_checker", "op": ">=", "value": -3.0},
    {"id": "G15", "suite": "on_demand", "name": "On-demand mode does not load Crisp for ordinary questions",
     "metric": "on_demand_skill_loads", "op": "<=", "value": 0},
    {"id": "G16", "suite": "tldr", "name": "TL;DR format (one sentence, at most three bullets)",
     "metric": "tldr_format_rate", "op": ">=", "value": 1.0},
    {"id": "G17", "suite": "tldr", "name": "TL;DR keeps the critical caveat",
     "metric": "tldr_caveat_rate", "op": ">=", "value": 1.0},
    {"id": "G18", "suite": "clarify", "name": "Clarify keeps the source facts",
     "metric": "clarify_fact_rate", "op": ">=", "value": 0.95},
    {"id": "G19", "suite": "clarify", "name": "Clarify adds no new facts",
     "metric": "clarify_added_facts", "op": "<=", "value": 0},
    {"id": "G20", "suite": "clarify", "name": "Clarify starts with a bottom line",
     "metric": "clarify_format_rate", "op": ">=", "value": 1.0},
    {"id": "G21", "suite": "check", "name": "Check cites only real rule IDs",
     "metric": "check_invalid_rule_ids", "op": "<=", "value": 0},
    {"id": "G22", "suite": "creative", "name": "Creative writing keeps its voice",
     "metric": "creative_not_worse_rate", "op": ">=", "value": 1.0}
  ]
}
